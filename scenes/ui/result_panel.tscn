[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/result_panel.gd" id="1_result"]

[node name="ResultPanel" type="VBoxContainer"]
layout_mode = 0
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_result")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "任务结算"

[node name="OutcomeLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "结果"

[node name="DetailsLabel" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 12
autowrap_mode = 2
text = "详情"

[node name="IntelTitle" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "新情报"

[node name="IntelList" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="ContinueButton" type="Button" parent="."]
layout_mode = 2
text = "返回委托板"

[connection signal="pressed" from="ContinueButton" to="." method="_on_continue_button_pressed"]
